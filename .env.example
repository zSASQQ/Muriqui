# Modelo de variáveis de ambiente. Copie para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" (ele contém a chave secreta).

# URL e chave pública do Supabase (podem aparecer no navegador)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# 🔒 Chave SECRETA — só no servidor. Nunca use em variáveis VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# 🔒 Token do webhook da Hotmart (o mesmo cadastrado na Hotmart)
HOTMART_HOTTOK=""
